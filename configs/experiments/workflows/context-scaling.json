{
  "schema_version": "1.0.0",
  "id": "context-scaling",
  "classification": "quantitative",
  "steps": [
    {
      "module": "sspace.experiments.spinbench.perspective_taking.tools.run_spinbench_layerwise_sweep",
      "args": [
        "--configs",
        "configs/experiments/spinbench/eval_molmo2_er_spinbench_without_premise_rotation.json",
        "configs/experiments/spinbench/eval_molmo2_er_spinbench_with_premise_rotation.json",
        "--output-root",
        "outputs/reproduction/spinbench_layerwise"
      ],
      "model": "molmo2_er"
    },
    {
      "module": "sspace.experiments.analysis.plot_quantitative",
      "args": [
        "--protocol",
        "context",
        "--inputs",
        "outputs/reproduction/spinbench_layerwise/molmo2_er/without/layerwise_metrics.csv",
        "outputs/reproduction/spinbench_layerwise/molmo2_er/with/layerwise_metrics.csv",
        "--output-dir",
        "outputs/reproduction/context_scaling/molmo2_er"
      ],
      "model": "molmo2_er"
    },
    {
      "module": "sspace.experiments.spinbench.perspective_taking.tools.run_spinbench_layerwise_sweep",
